<Window x:Class="CafeOabi.BrewPOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Café Oabi • BrewPOS for Windows" Width="1470" Height="880"
    MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
    Background="#F7F7F0">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE4DC" BorderThickness="0,0,0,1">
      <Grid Margin="25,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#38654D" CornerRadius="11" Height="43" Width="43">
            <TextBlock Text="☕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
          </Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Café Oabi" FontSize="22" FontWeight="Bold" Foreground="#284A37"/>
            <TextBlock Text="BREWPOS FOR WINDOWS • HYBRID" FontSize="10" FontWeight="SemiBold" Foreground="#789080"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#EAF4EC" Padding="12,7" CornerRadius="9" Margin="0,0,16,0">
            <TextBlock x:Name="Connectivity" Text="● OFFLINE" Foreground="#266D48" FontSize="12" FontWeight="Bold"/>
          </Border>
          <StackPanel>
            <TextBlock x:Name="BranchText" Text="Café Oabi • No branch connected" TextAlignment="Right" FontWeight="SemiBold"/>
            <TextBlock x:Name="LicenseText" Text="Activation required" TextAlignment="Right" Foreground="#8E6442" FontSize="11"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#FFFFFF" BorderBrush="#E1E7DF" BorderThickness="0,0,1,0">
        <DockPanel Margin="13,21,13,17">
          <StackPanel DockPanel.Dock="Bottom">
            <Border CornerRadius="10" Background="#EDF5EE" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="HYBRID CLOUD SYNC" Foreground="#4B8060" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="PendingText" Text="0 queued • 0 review" Margin="0,10,0,0" FontSize="12"/>
                <TextBlock Text="Sales work offline after first activation." TextWrapping="Wrap" Foreground="#708577" FontSize="11" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
            <Button Content="↻ Sync pending" Click="Sync_Click" Background="#517E67"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#8F9D94" Margin="13,0,0,15"/>
            <Button Content="▦   Cashier / Orders" Click="OpenCashier" Height="47"/>
            <Button Content="▤   Inventory" Click="OpenInventory" Height="47" Background="#F0F5F1" Foreground="#315941"/>
            <Button Content="▥   Sales &amp; Sync" Click="OpenHistory" Height="47" Background="#F0F5F1" Foreground="#315941"/>
            <Button Content="⚙   Settings &amp; License" Click="OpenSettings" Height="47" Background="#F0F5F1" Foreground="#315941"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TabControl x:Name="Pages" Grid.Column="1" BorderThickness="0" Background="Transparent" Margin="18,16,18,18">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl"><Border Background="Transparent">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </Border></ControlTemplate>
        </TabControl.Template>
        <TabItem Header="Cashier">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="New Café Order" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Coffee, food, and drink customization in one checkout."
                           FontSize="12" Foreground="#7F8D83" Margin="0,5,0,0"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="F2 Search  •  F4 Checkout  •  F5 Sync" FontSize="11"
                         Foreground="#538269" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="385"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="White" CornerRadius="13" BorderBrush="#DFE7DF" BorderThickness="1" Padding="17">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Café Menu" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="MenuCount" Text="Load the approved Café Oabi menu from BrewPOS Cloud"
                               FontSize="11" Foreground="#82948A" Margin="0,5,0,0"/>
                  </StackPanel>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchInput" Height="42" ToolTip="Search name or scan barcode"/>
                    <ComboBox x:Name="CategoryBox" Grid.Column="1" Height="42" SelectionChanged="CategoryChanged"/>
                    <Button Grid.Column="2" Content="Find" Click="Search_Click" Background="#E5F0E8" Foreground="#396148"/>
                  </Grid>
                  <DataGrid x:Name="MenuGrid" Grid.Row="4" AutoGenerateColumns="False" MouseDoubleClick="Add_Click">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="MENU ITEM" Binding="{Binding Name}" Width="2*"/>
                      <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="*"/>
                      <DataGridTextColumn Header="PRICE" Binding="{Binding DisplayPrice}" Width="*"/>
                      <DataGridTextColumn Header="STOCK" Binding="{Binding StockLabel}" Width=".6*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Border Grid.Row="5" Background="#F6F9F5" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="Customize selected item" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,9"/>
                      <WrapPanel>
                        <ComboBox x:Name="SizeBox" Width="111" SelectedIndex="0" ToolTip="Drink size">
                          <ComboBoxItem Content="Regular"/><ComboBoxItem Content="Large (+₱20)"/>
                        </ComboBox>
                        <ComboBox x:Name="SugarBox" Width="109" SelectedIndex="0" ToolTip="Sugar level">
                          <ComboBoxItem Content="100% sugar"/><ComboBoxItem Content="75% sugar"/><ComboBoxItem Content="50% sugar"/>
                          <ComboBoxItem Content="25% sugar"/><ComboBoxItem Content="0% sugar"/>
                        </ComboBox>
                        <ComboBox x:Name="IceBox" Width="100" SelectedIndex="0" ToolTip="Ice level">
                          <ComboBoxItem Content="Regular ice"/><ComboBoxItem Content="Less ice"/><ComboBoxItem Content="No ice"/>
                        </ComboBox>
                        <TextBox x:Name="QuantityBox" Width="48" Text="1" ToolTip="Quantity"/>
                        <Button Content="+ Add" Click="Add_Click"/>
                      </WrapPanel>
                      <CheckBox x:Name="ShotBox" Content="Extra espresso shot (+₱40)" Margin="4,8,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Column="2" Background="White" CornerRadius="13" BorderBrush="#DFE7DF"
                      BorderThickness="1" Padding="17">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Current Order" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="CartCount" Text="0 item lines" Foreground="#82948A" FontSize="11" Margin="0,5,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                      <ComboBox x:Name="ServiceBox" Width="114" SelectedIndex="0">
                        <ComboBoxItem Content="Dine-in"/><ComboBoxItem Content="Takeout"/>
                      </ComboBox>
                      <TextBox x:Name="TableBox" Width="116" ToolTip="Table no. or order notes"/>
                    </WrapPanel>
                  </StackPanel>
                  <DataGrid x:Name="CartGrid" Grid.Row="2" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="1.8*"/>
                      <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width=".5*"/>
                      <DataGridTextColumn Header="AMOUNT" Binding="{Binding PriceLabel}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Button Grid.Row="3" Content="Remove selected" Click="Remove_Click"
                          Background="#F6EDEE" Foreground="#A04C56" HorizontalAlignment="Right"/>
                  <Border Grid.Row="4" Background="#F0F6F0" CornerRadius="11" Padding="14" Margin="0,9,0,0">
                    <StackPanel>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal"/><TextBlock x:Name="SubtotalText" Grid.Column="1" Text="₱0.00"/>
                      </Grid>
                      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Discount"/><TextBlock Grid.Column="1" x:Name="DiscountLabel" Text="₱0.00"/>
                      </Grid>
                      <TextBlock Text="AMOUNT DUE" Foreground="#65826E" FontWeight="Bold" FontSize="11" Margin="0,12,0,0"/>
                      <TextBlock x:Name="TotalText" Text="₱0.00" FontSize="32" FontWeight="Bold" Foreground="#2D6644"/>
                      <WrapPanel>
                        <TextBlock Text="Discount ₱" Width="88" VerticalAlignment="Center"/>
                        <TextBox x:Name="DiscountInput" Width="84" Text="0" TextChanged="MoneyChanged"/>
                        <TextBlock Text="Cash ₱" Width="65" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        <TextBox x:Name="TenderInput" Width="87" Text="0" TextChanged="MoneyChanged"/>
                      </WrapPanel>
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Change"/><TextBlock x:Name="ChangeText" Text="₱0.00" Grid.Column="1"
                                                            FontWeight="Bold" Foreground="#24764A" FontSize="16"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Row="5">
                    <Button Content="Complete CASH Sale →" Height="52" Click="Checkout_Click" FontSize="15" Margin="0,13,0,0"/>
                    <TextBlock Text="Sale + receipt saved locally before cloud sync."
                               TextAlignment="Center" Foreground="#8A9B91" FontSize="10" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Inventory">
          <Grid Margin="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Inventory &amp; Stock" FontSize="24" FontWeight="Bold"/>
              <TextBlock Text="Local stock adjustments remain pending until BrewPOS Cloud inventory sync is enabled."
                         Foreground="#B26F39" TextWrapping="Wrap" Margin="0,9,0,15"/>
            </StackPanel>
            <DataGrid x:Name="InventoryGrid" Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="STOCK" Binding="{Binding StockLabel}" Width="*"/>
                <DataGridTextColumn Header="PRICE" Binding="{Binding DisplayPrice}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Text="Stock movement (+ / −)" VerticalAlignment="Center"/>
              <TextBox x:Name="DeltaInput" Width="100" Text="0"/>
              <TextBox x:Name="ReasonInput" Width="235" Text="Restock" ToolTip="Reason"/>
              <Button Content="Save offline adjustment" Click="Adjust_Click"/>
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Sales">
          <Grid Margin="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBlock Text="Sales, Receipts &amp; Sync" FontSize="24" FontWeight="Bold"/>
              <Button Content="↻ Sync" Click="Sync_Click" Margin="20,0,0,0"/>
              <Button Content="Print customer" Click="PrintCustomer_Click" Background="#5E8970"/>
              <Button Content="Print barista slip" Click="PrintBarista_Click" Background="#73846B"/>
            </StackPanel>
            <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="HistorySelected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="LOCAL DATE" Binding="{Binding Created}" Width="2*"/>
                <DataGridTextColumn Header="EVENT" Binding="{Binding Kind}" Width="1.5*"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="3*"/>
                <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="ReceiptPreview" Grid.Row="2" IsReadOnly="True"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Background="#FFFFFF"/>
          </Grid>
        </TabItem>
        <TabItem Header="Settings">
          <ScrollViewer>
            <StackPanel Margin="12" Width="570" HorizontalAlignment="Left">
              <TextBlock Text="Café Settings &amp; Device License" FontSize="24" FontWeight="Bold"/>
              <TextBlock Text="Activation" FontWeight="Bold" Margin="0,20,0,5"/>
              <TextBlock x:Name="DeviceText" Text="Device not initialized" Foreground="#5B8167" FontSize="12" TextWrapping="Wrap"/>
              <TextBox x:Name="ActivationInput" Margin="0,10,0,8" ToolTip="Paste Owner-issued BP1 activation token"/>
              <Button Content="Verify &amp; save signed activation" Click="Activate_Click"/>
              <TextBlock Text="Printer installed in Windows" FontWeight="Bold" Margin="0,22,0,6"/>
              <TextBox x:Name="PrinterInput" ToolTip="Exact printer name from Printers &amp; scanners"/>
              <CheckBox x:Name="AutoPrint" Content="Automatically print customer and barista slips" IsChecked="True" Margin="0,10,0,12"/>
              <Button Content="Save printer settings" Click="SavePrinter_Click"/>
              <TextBlock Text="Cloud / Café Oabi Branch" FontWeight="Bold" Margin="0,22,0,7"/>
              <TextBlock x:Name="TenantText" Text="Not connected" TextWrapping="Wrap" Foreground="#637D6B"/>
              <Button Content="Register this PC (owner / manager)" Click="Register_Click" Margin="0,11,0,0"/>
              <Button Content="Refresh approved café menu" Click="RefreshMenu_Click" Margin="0,8,0,0"/>
              <Button Content="Sign out (keep local receipts)" Click="SignOut_Click" Background="#8E7267" Margin="0,20,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E9DF" BorderThickness="0,1,0,0">
      <Grid Margin="23,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Offline-first • Ready" Foreground="#6A8070" VerticalAlignment="Center" FontSize="11"/>
        <TextBlock Grid.Column="1" Text="Café Oabi • Powered by BrewPOS / Azurate" VerticalAlignment="Center"
                   Foreground="#8B9A8F" FontSize="11"/>
      </Grid>
    </Border>
    <Grid x:Name="LoginOverlay" Grid.RowSpan="3" Background="#E4F2F3EC">
      <Border Width="440" Background="White" CornerRadius="15" BorderBrush="#D4E1D4" BorderThickness="1"
              Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="☕ Café Oabi" FontSize="27" FontWeight="Bold" Foreground="#315A40"/>
          <TextBlock Text="BrewPOS Windows • Sign in to your verified café account"
                     Foreground="#7E9081" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,25"/>
          <TextBlock Text="Staff email" FontWeight="SemiBold"/>
          <TextBox x:Name="EmailInput" Height="42" Margin="0,6,0,12"/>
          <TextBlock Text="Password" FontWeight="SemiBold"/>
          <PasswordBox x:Name="PasswordInput" Height="42" Margin="0,6,0,16"/>
          <Button Content="Sign in and load Café Oabi" Height="47" Click="SignIn_Click"/>
          <Button Content="Open saved offline session" Height="43" Click="Offline_Click"
                  Background="#E5EFE5" Foreground="#335642" Margin="0,10,0,0"/>
          <TextBlock x:Name="LoginError" Foreground="#B34941" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock Text="First setup needs internet, an owner-approved Café Oabi membership, registered PC and valid BP1 activation."
                     FontSize="11" Foreground="#87958A" Margin="0,19,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
