<Application x:Class="CafeOabi.BrewPOS.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#38654D"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#23362D"/>
      <Setter Property="BorderBrush" Value="#CCD8CF"/><Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#253C30"/>
      <Setter Property="BorderBrush" Value="#CCD8CF"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#23362D"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263B30"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="43"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>
  </Application.Resources>
</Application>
